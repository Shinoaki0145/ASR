# Mặc định app đọc .env ở gốc ASR. Hoặc đặt ASR_ENV_PATH=/đường/dẫn/.env
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=YOUR_GEMINI_MODEL
LLM_API_KEY=YOUR_API_KEY
# Model riêng cho resolver; bỏ trống để dùng LLM_MODEL
TURN_MODEL=
RESOLVE_TIMEOUT_SECONDS=5
SEGMENT_SILENCE_SECONDS=1
WEB_FAKE=false
WEB_SHARE=false
WEB_HOST=127.0.0.1
WEB_PORT=7860
# Bắt buộc khi WEB_SHARE=true hoặc bind 0.0.0.0
WEB_USERNAME=demo
WEB_PASSWORD=CHANGE_THIS_PASSWORD
# Giọng đọc Edge-TTS (vi-VN-HoaiMyNeural nữ, vi-VN-NamMinhNeural nam, hoặc espeak)
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
