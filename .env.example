# Notebook Hoi_Thoai_Ngat_Loi_Test.ipynb đọc file này từ thư mục làm việc.
# Colab: upload .env vào /content. Không chia sẻ file có API key.

# demo: thử logic, không gọi model/API; real: chạy hệ thống thật.
RUN_MODE=demo
REAL_INPUT=audio
VAD_DEVICE=cuda
PLAYBACK=simulate

# Điền URL gốc của máy chủ hỗ trợ chat-completions, thường kết thúc bằng /v1.
# Không thêm /chat/completions vào URL bên dưới.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Tùy chọn: model riêng để chốt lượt và cập nhật yêu cầu.
# Bỏ trống để dùng LLM_MODEL.
TURN_MODEL=

# Chốt đoạn audio sau số giây im lặng này; không chờ LLM endpoint.
SEGMENT_SILENCE_SECONDS=1.0

# Timeout cho LLM cập nhật yêu cầu; vẫn hủy ngay khi người dùng nói tiếp.
RESOLVE_TIMEOUT_SECONDS=5.0
