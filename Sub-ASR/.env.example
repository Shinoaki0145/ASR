# URL gốc đã bao gồm /v1, không thêm /chat/completions ở đây.
# Dùng máy chủ của bạn cung cấp giao thức chat-completions HTTP/SSE.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=your-vietnamese-instruct-model
# Có thể bỏ trống nếu máy chủ local không yêu cầu key.
LLM_API_KEY=
# Bỏ trống để dùng LLM_MODEL cho cả nhận định kết thúc lượt.
TURN_MODEL=
